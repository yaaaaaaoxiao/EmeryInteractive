{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    // the build config imports app files directly, which Vite wants written with their extension
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "vite-plugins"]
}
